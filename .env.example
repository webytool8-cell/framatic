# ---- Supabase (required) ----
# Project Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used by background analysis/generation jobs and rate limiting. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the app (used for email confirmation links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- AI (required for brand interpretation and concept generation) ----
# Without it, analysis still runs but only fills in content found verbatim on the site.
ANTHROPIC_API_KEY=
# Optional model override
FRAMATIC_LLM_MODEL=claude-sonnet-5-5
# Faster, cheaper model for reading product pages (falls back to the model above if its answer is invalid)
FRAMATIC_ANALYSIS_MODEL=claude-haiku-5-5

# ---- Website analysis (optional) ----
# Render client-side (SPA) sites with Playwright/Chromium. Requires `npm i playwright`
# and a Chromium binary on the server — not available on most serverless hosts.
FRAMATIC_ENABLE_BROWSER=false

# ---- Rate limits per user per hour (optional) ----
FRAMATIC_LIMIT_ANALYZE_PER_HOUR=10
FRAMATIC_LIMIT_GENERATE_PER_HOUR=10
FRAMATIC_LIMIT_REGENERATE_PER_HOUR=40

# ---- MP4 export on Google Cloud Run Jobs (optional) ----
# See docs/gcp/SETUP.md.
GCP_PROJECT_ID=
GCP_REGION=us-central1
# Service-account key JSON (or base64 of it) with the Cloud Run Developer role
GCP_SERVICE_ACCOUNT_KEY=
# Optional
FRAMATIC_RENDER_JOB=framatic-renderer
FRAMATIC_LIMIT_RENDER_PER_HOUR=20

# ---- Sign-in options ----
# Show "Continue with Google" (also enable the Google provider in Supabase → Authentication → Providers)
NEXT_PUBLIC_AUTH_GOOGLE=false

# Credits: every plan gets monthly credits (amounts and costs in src/lib/plans.ts).
# Set a user's plan in Supabase: insert into user_plans (user_id, plan) values ('<uuid>', 'pro');
# FRAMATIC_CREDITS=off   # switch credit checks off entirely
# Admin access code: entering it in Settings → "Have an access code?" gives that account
# unlimited credits. Must be 24+ characters; generate with: openssl rand -hex 32
FRAMATIC_ADMIN_TOKEN=
# Who can open /admin/usage (cost per project, per export, per user)
FRAMATIC_ADMIN_EMAILS=

# Photos in videos. Product photos are copied from the product page automatically.
# AI photos use Vertex AI with the same GCP project/service account as rendering
# (give the service account the "Vertex AI User" role and enable the Vertex AI API).
# FRAMATIC_AI_PHOTOS=off
# FRAMATIC_IMAGE_MODEL=gemini-2.5-flash-image
# FRAMATIC_AI_PHOTOS_PER_CONCEPT=1
