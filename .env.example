# ---- Supabase (required) ----
# Project Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used by background analysis/generation jobs and rate limiting. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the app (used for email confirmation links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- AI (required for brand interpretation and concept generation) ----
# Without it, analysis still runs but only fills in content found verbatim on the site.
ANTHROPIC_API_KEY=
# Optional model override
FRAMATIC_LLM_MODEL=claude-sonnet-5-5

# ---- Website analysis (optional) ----
# Render client-side (SPA) sites with Playwright/Chromium. Requires `npm i playwright`
# and a Chromium binary on the server — not available on most serverless hosts.
FRAMATIC_ENABLE_BROWSER=false

# ---- Rate limits per user per hour (optional) ----
FRAMATIC_LIMIT_ANALYZE_PER_HOUR=10
FRAMATIC_LIMIT_GENERATE_PER_HOUR=10
FRAMATIC_LIMIT_REGENERATE_PER_HOUR=40
